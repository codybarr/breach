{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "breach",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/ws"]
  },
  "durable_objects": {
    "bindings": [{ "name": "LOBBY", "class_name": "LobbyDO" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["LobbyDO"] }],
  "observability": { "enabled": true },
  // To serve on your own domain, add:
  "routes": [{ "pattern": "breach.codybarr.dev", "custom_domain": true }]
}
