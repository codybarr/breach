{
  "name": "breach-exe",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && tsc --noEmit -p server && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p server",
    "dev:lan": "vite --host",
    "server": "bun server/main.ts",
    "serve": "vite build && bun server/main.ts"
  },
  "dependencies": {
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/three": "^0.187.0",
    "playwright": "^1.65.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
